rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerUid) {
      return isSignedIn() && request.auth.uid == ownerUid;
    }

    function isSuperUser() {
       return isSignedIn() && (
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.superuser == true
       );
    }

    function isParticipant(participants) {
      return isSignedIn() && (request.auth.uid in participants);
    }
    
    function isFriend(ownerUid) {
      return isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/users/$(ownerUid)).data.get('friends', []);
    }

    // --- Collections ---

    // 1. Users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isSuperUser() || (
        isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'superuser'])
      ) || (
        // Allow other users to add/remove THEMSELVES from this user's friends list
        isSignedIn() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends']) &&
        (
          (request.resource.data.friends.hasAll(resource.data.friends) && request.resource.data.friends.size() == resource.data.friends.size() + 1 && request.resource.data.friends.hasAny([request.auth.uid])) ||
          (resource.data.friends.hasAll(request.resource.data.friends) && request.resource.data.friends.size() == resource.data.friends.size() - 1 && !request.resource.data.friends.hasAny([request.auth.uid]))
        )
      );
    }

    // 2. Folders
    match /folders/{folderId} {
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isOwner(resource.data.ownerUid) || isSuperUser();
      allow read: if isSignedIn() && (
                    isOwner(resource.data.ownerUid) || 
                    resource.data.privacy == 'public' ||
                    (resource.data.privacy == 'friends' && isFriend(resource.data.ownerUid)) ||
                    isSuperUser()
                  );
    }

    // 3. Items & Interactions
    match /items/{itemId} {
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      
      allow update: if isOwner(resource.data.ownerUid) || isSuperUser() || (
        isSignedIn() && (
           (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy']) && 
            request.resource.data.likes == request.resource.data.likedBy.size() &&
            (request.resource.data.likedBy.hasAll(resource.data.likedBy) || resource.data.likedBy.hasAll(request.resource.data.likedBy))) 
           ||
           (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
            request.resource.data.views == resource.data.views + 1)
           ||
           (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']) &&
            request.resource.data.commentCount == resource.data.commentCount + 1)
        )
      );
      
      allow delete: if isOwner(resource.data.ownerUid) || isSuperUser();
      allow read: if isSignedIn() && (
        isOwner(resource.data.ownerUid) || 
        isSuperUser() ||
        get(/databases/$(database)/documents/folders/$(resource.data.folderId)).data.privacy == 'public' ||
        (
          get(/databases/$(database)/documents/folders/$(resource.data.folderId)).data.privacy == 'friends' && 
          isFriend(get(/databases/$(database)/documents/folders/$(resource.data.folderId)).data.ownerUid)
        )
      );

      // Comments Subcollection
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow delete: if isSignedIn() && (request.auth.uid == resource.data.userId || isSuperUser());
      }
    }

    // 4. Friend Requests — FIX: field names match code (fromUid/toUid)
    match /friend_requests/{requestId} {
      allow read: if isSignedIn() && (
                    request.auth.uid == resource.data.fromUid || 
                    request.auth.uid == resource.data.toUid
                  );
      allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid;
      allow update: if isSignedIn() && request.auth.uid == resource.data.toUid;
    }

    // 5. Chats & Messages
    match /chats/{chatId} {
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants && (
        // Standard message updates don't touch participants or admins
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants', 'admins']) ||
        // Only admins can modify participants or admins (fallback to all participants if no admins array exists yet)
        request.auth.uid in resource.data.get('admins', resource.data.participants) ||
        isSuperUser()
      );
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                      && request.resource.data.userId == request.auth.uid;
      }
    }

    // 6. Drafts (Projects)
    match /drafts/{draftId} {
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isOwner(resource.data.ownerUid) || isSuperUser();
      allow read: if isSignedIn() && (
                    isOwner(resource.data.ownerUid) || isSuperUser()
                  );
    }

    // 7. Game Rooms (Multiplayer)
    match /game_rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.hostUid == request.auth.uid;
      // Host can update anything; regular players can only update aspects involving themselves (via Cloud Functions conceptually, but we allow general updates here for the MVP if they affect players/state)
      allow update: if isSignedIn() && (
        isOwner(resource.data.hostUid) || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'answers', 'state']) 
      );
      allow delete: if isOwner(resource.data.hostUid) || isSuperUser();

      // Messages subcollection for AI Chat
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
      }

      match /answers/{answerId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      }
    }
  }
}
