rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerUid) {
      return isSignedIn() && request.auth.uid == ownerUid;
    }

    function isSuperUser() {
       return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isParticipant(participants) {
      return isSignedIn() && (request.auth.uid in participants);
    }

    // --- Collections ---

    // 1. Users
    // - Any signed-in user can read individual profiles.
    // - Only superusers can LIST all users (for admin panel).
    // - Owner can update their own profile, but CANNOT change their role.
    // - SuperUser can write any user doc (including role changes).
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSuperUser();
      allow create: if isOwner(userId);
      allow update: if isSuperUser() || (
        isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
      );
    }

    // 2. Folders
    match /folders/{folderId} {
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isOwner(resource.data.ownerUid) || isSuperUser();
      allow read: if isSignedIn() && (
                    isOwner(resource.data.ownerUid) || 
                    resource.data.privacy == 'public' ||
                    isSuperUser()
                  );
    }

    // 3. Items & Interactions
    match /items/{itemId} {
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      
      // Owner or SuperUser: full update/delete
      // Authenticated users: toggle likes or increment views only
      allow update: if isOwner(resource.data.ownerUid) || isSuperUser() || (
        isSignedIn() && (
           // Case 1: Toggling Like (update 'likes' and 'likedBy')
           (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy']) && 
            request.resource.data.likes == request.resource.data.likedBy.size() &&
            (request.resource.data.likedBy.hasAll(resource.data.likedBy) || resource.data.likedBy.hasAll(request.resource.data.likedBy))) 
           ||
           // Case 2: Increment View (update 'views' only)
           (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
            request.resource.data.views == resource.data.views + 1)
        )
      );
      
      allow delete: if isOwner(resource.data.ownerUid) || isSuperUser();

      allow read: if isSignedIn() && (
                    isOwner(resource.data.ownerUid) || 
                    resource.data.privacy == 'public' ||
                    isSuperUser()
                  );

      // Comments Subcollection
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow delete: if isSignedIn() && (request.auth.uid == resource.data.userId || isSuperUser());
      }
    }

    // 4. Friend Requests
    match /friend_requests/{requestId} {
      allow read: if isSignedIn() && (
                    request.auth.uid == resource.data.from || 
                    request.auth.uid == resource.data.to
                  );
      allow create: if isSignedIn() && request.resource.data.from == request.auth.uid;
      allow update: if isSignedIn() && request.auth.uid == resource.data.to;
    }

    // 5. Chats & Messages
    match /chats/{chatId} {
      allow read, write: if isParticipant(resource.data.participants);
      
      match /messages/{messageId} {
        allow read, write: if isParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
      }
    }

    // 6. Drafts (Projects)
    match /drafts/{draftId} {
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isOwner(resource.data.ownerUid) || isSuperUser();
      allow read: if isSignedIn() && (
                    isOwner(resource.data.ownerUid) || isSuperUser()
                  );
    }
  }
}
